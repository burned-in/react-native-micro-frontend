{
  "name": "@bunin/react-native-micro-frontend-cli",
  "version": "0.6.3",
  "author": "bunin contributors",
  "homepage": "https://rnmfe.bunin.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burned-in/react-native-micro-frontend.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/mjs/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "bin": {
    "rnm": "dist/bin/rnm.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@bunin/react-native-micro-frontend": "workspace:*",
    "@bunin/react-native-micro-frontend-config": "workspace:*",
    "@bunin/react-native-micro-frontend-hot-updater-adapter": "workspace:*",
    "@bunin/react-native-micro-frontend-integration": "workspace:*",
    "@bunin/react-native-micro-frontend-metro-adapter": "workspace:*",
    "@bunin/react-native-micro-frontend-native-contract": "workspace:*",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "module": "./dist/mjs/index.mjs"
}
