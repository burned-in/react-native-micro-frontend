{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/cli.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "bin/**/*.ts"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../native-contract"
    },
    {
      "path": "../integration"
    },
    {
      "path": "../hot-updater-adapter"
    },
    {
      "path": "../metro-adapter"
    }
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
