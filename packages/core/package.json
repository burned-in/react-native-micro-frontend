{
  "name": "@bunin/react-native-micro-frontend",
  "version": "0.6.1",
  "author": "bunin contributors",
  "homepage": "https://rnmfe.bunin.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burned-in/react-native-micro-frontend.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/mjs/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./hot-updater": {
      "types": "./dist/src/hot-updater.d.ts",
      "import": "./dist/mjs/hot-updater.mjs",
      "require": "./dist/cjs/hot-updater.cjs"
    },
    "./bundle-archive": {
      "types": "./dist/src/bundle-archive.d.ts",
      "import": "./dist/mjs/bundle-archive.mjs",
      "require": "./dist/cjs/bundle-archive.cjs"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/mjs/runtime.mjs",
      "require": "./dist/cjs/runtime.cjs"
    },
    "./metro": {
      "types": "./dist/src/metro.d.ts",
      "import": "./dist/mjs/metro.mjs",
      "require": "./dist/cjs/metro.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.70.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "module": "./dist/mjs/index.mjs"
}
