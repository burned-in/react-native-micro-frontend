{
  "name": "react-native-micro-frontend-monorepo",
  "private": true,
  "version": "0.4.1",
  "author": "bunin contributors",
  "homepage": "https://rnmfe.bunin.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burned-in/react-native-micro-frontend.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && bun scripts/build-dual.mjs",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc -b --pretty false",
    "test": "bun test ./packages/core/src ./packages/native-contract/src ./packages/hot-updater-adapter/src ./packages/config/src ./packages/cli/src",
    "clean": "find packages -type d -name dist -prune -exec rm -rf {} +",
    "version:all": "bun scripts/release/version-all.mjs",
    "pack:all": "bun run build && bun scripts/release/pack-all.mjs",
    "publish:all:dry-run": "bun run build && bun scripts/release/publish-all.mjs --dry-run",
    "publish:all": "bun run build && bun scripts/release/publish-all.mjs",
    "release:check": "bun run lint && bun run test && bun run typecheck && bun run build && bun run docs:typecheck && bun run docs:build && bun scripts/release/pack-all.mjs",
    "release:dry-run": "bun run release:check && bun run publish:all:dry-run",
    "release:publish": "bun run release:check && bun run publish:all",
    "docs:codegen": "cd apps/docs-site && bun run codegen",
    "docs:dev": "cd apps/docs-site && bun run dev",
    "docs:typecheck": "cd apps/docs-site && bun run typecheck",
    "docs:build": "cd apps/docs-site && bun run build && cd ../.. && bun run docs:seo-assets",
    "docs:preview": "cd apps/docs-site && bun run preview",
    "docs:build:github-pages": "GITHUB_PAGES_BASE=${GITHUB_PAGES_BASE:-/react-native-micro-frontend/} VITE_PUBLIC_SITE_ORIGIN=${VITE_PUBLIC_SITE_ORIGIN:-https://burned-in.github.io} bun run docs:build && touch apps/docs-site/dist/client/.nojekyll",
    "docs:build:github-pages:root": "GITHUB_PAGES_BASE=${GITHUB_PAGES_BASE:-/} VITE_PUBLIC_SITE_ORIGIN=${VITE_PUBLIC_SITE_ORIGIN:-https://burned-in.github.io} bun run docs:build && touch apps/docs-site/dist/client/.nojekyll",
    "docs:seo-assets": "bun scripts/docs/generate-seo-assets.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@pandacss/dev": "^1.11.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "typescript": "^5.8.3",
    "vike": "^0.4.259",
    "vike-react": "^0.6.23",
    "vite": "^8.0.14"
  },
  "license": "MIT"
}
